---
import styles from "./Footer.module.scss";

interface Props {
	// トップの記事一覧に合わせて広げる
	wide?: boolean;
}

const { wide = false } = Astro.props;
---

<footer class:list={[styles.footer, wide && styles.wide]}>
	<ul class={styles.links}>
		<li>
			<a href="https://pocopota.io">pocopota.io</a>
		</li>
		<li>
			<a href="https://pocopota.io/privacypolicy">プライバシーポリシー</a>
		</li>
		<li>
			<a href="https://pocopota.io/sitepolicy">サイトポリシー</a>
		</li>
	</ul>
	<p>&copy; PocoPota</p>
</footer>
