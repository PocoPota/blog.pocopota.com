---
import { getCollection, render } from "astro:content";

import Article from "@/components/post/Article.astro";
import SeriesList from "@/components/series/SeriesList.astro";
import Layout from "@/layouts/Layout.astro";
import { getSeriesInfo } from "@/lib/series";

import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () => {
	const posts = await getCollection("posts");
	return posts.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const body = entry.body ?? "";

const seriesInfo = await getSeriesInfo(entry);
---

<Layout
	title={entry.data.title}
	description={entry.data.description}
	ogImage={entry.data.thumbnail ?? `/og/${entry.id}.png`}
	ogType="article"
>
	{body.includes('class="fa') && (
		<link
			slot="head"
			rel="stylesheet"
			href="https://use.fontawesome.com/releases/v5.13.0/css/all.css"
			crossorigin="anonymous"
		/>
	)}
	{body.includes("twitter-tweet") && (
		<script
			slot="head"
			is:inline
			async
			src="https://platform.twitter.com/widgets.js"
		/>
	)}
	<Article
		title={entry.data.title}
		date={entry.data.date}
		series={
			seriesInfo && {
				title: seriesInfo.series.data.title,
				href: `/series/${seriesInfo.series.id}/`,
				group: seriesInfo.group.name,
				position: seriesInfo.position,
				total: seriesInfo.total,
			}
		}
	>
		<Content />
		{seriesInfo && (
			<SeriesList
				slot="footer"
				heading={`${seriesInfo.group.name}の記事`}
				posts={seriesInfo.group.posts}
				currentId={entry.id}
			/>
		)}
	</Article>
</Layout>
