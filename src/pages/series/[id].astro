---
import { getCollection, render } from "astro:content";

import Article from "@/components/post/Article.astro";
import SeriesList from "@/components/series/SeriesList.astro";
import Layout from "@/layouts/Layout.astro";
import { getSeriesGroups } from "@/lib/series";

import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () => {
	const series = await getCollection("series");
	return series.map((entry) => ({
		params: { id: entry.id },
		props: { entry },
	}));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const groups = await getSeriesGroups(entry);
---

<Layout
	title={entry.data.title}
	description={entry.data.description}
	ogImage={`/og/series/${entry.id}.png`}
>
	<Article title={entry.data.title}>
		<p>{entry.data.description}</p>
		<Content />
		<Fragment slot="footer">
			{groups.map((group) => (
				<SeriesList heading={group.name} posts={group.posts} />
			))}
		</Fragment>
	</Article>
</Layout>
